# Hostinger runtime settings. Replace every placeholder privately in hPanel.
APP_URL=https://keys.example.com
PORT=3000
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=your_full_prefixed_database_name
DB_USER=your_full_prefixed_database_username
DB_PASSWORD=your_database_password
# Pin the fixed owner email before first setup. Enter your own address privately.
ADMIN_EMAIL=your_owner_email@example.com
# Generate these two server secrets with npm run hostinger:secrets.
SESSION_SECRET=replace_with_generated_session_secret
BILLING_ENCRYPTION_KEY=replace_with_generated_base64_key
# Optional compatibility only for an old owner row without a database key hash.
# Fresh installs issue the owner key after email verification; leave this blank.
ADMIN_PASSWORD_HASH=
# DB_SSL=true is only needed for an external MySQL provider requiring TLS.

# Required for owner email-code delivery. Keep these private in hPanel.
# Verify this sender domain in Resend before first setup or key recovery.
RESEND_API_KEY=replace_with_resend_sending_api_key
AUTH_EMAIL_FROM=Keymeter <auth@your-verified-domain.com>
